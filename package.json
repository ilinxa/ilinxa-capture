{
  "name": "ilinxa-capture",
  "version": "0.1.1",
  "description": "Video Frame Extraction & Composition Service for AI Vision Pipelines",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "mcp:stdio": "node dist/mcp-entry.js"
  },
  "keywords": [
    "video",
    "frame-extraction",
    "ffmpeg",
    "yt-dlp",
    "sharp",
    "ai",
    "vision",
    "llm",
    "mcp",
    "mcp-server",
    "fastify",
    "contact-sheet"
  ],
  "license": "Apache-2.0",
  "author": "ilinxa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilinxa/ilinxa-capture.git"
  },
  "bugs": {
    "url": "https://github.com/ilinxa/ilinxa-capture/issues"
  },
  "homepage": "https://github.com/ilinxa/ilinxa-capture#readme",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/error": "^4.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "archiver": "^7.0.1",
    "fastify": "^5.8.2",
    "fastify-type-provider-zod": "^6.1.0",
    "p-queue": "^9.1.0",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.5.0",
    "@types/sharp": "^0.31.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
