# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Storage
STORAGE_MODE=local
LOCAL_OUTPUT_DIR=./data/jobs
LOCAL_TTL_SECONDS=3600

# Processing Limits
MAX_VIDEO_DURATION=600
MAX_UPLOAD_SIZE=524288000
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=300

# MCP (HTTP transport)
# Idle HTTP sessions are closed after this many seconds
MCP_SESSION_TTL=1800

# S3 / Cloudflare R2 (only when STORAGE_MODE=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_URL_EXPIRY=3600
