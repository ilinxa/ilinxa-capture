# Server
PORT=3000
HOST=127.0.0.1

# Network boundary. Loopback names and the bind address are always allowed.
# Comma-separated; * turns the check off.
# ALLOWED_HOSTS=capture.internal
# ALLOWED_ORIGINS=https://tools.internal

# Logging
LOG_LEVEL=info

# Storage
STORAGE_MODE=local
LOCAL_OUTPUT_DIR=./data/jobs
LOCAL_TTL_SECONDS=86400

# Local folders callers may read from, separated by ; on Windows and : elsewhere.
# * allows any path. Empty means: output folder only over HTTP, any path over stdio.
# ALLOWED_INPUT_DIRS=/media/films

# Processing Limits. 0 means no limit for MAX_VIDEO_DURATION and JOB_TIMEOUT.
MAX_VIDEO_DURATION=600
MAX_UPLOAD_SIZE=524288000
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=300
# Longest edge of llm grid sheets, in pixels. 0 means no limit.
MAX_SHEET_EDGE=2000

# MCP (HTTP transport)
# Idle HTTP sessions are closed after this many seconds
MCP_SESSION_TTL=1800

# S3 / Cloudflare R2 (only when STORAGE_MODE=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_URL_EXPIRY=3600
